source "https://rubygems.org"

# Match the GitHub Pages build environment (Jekyll version + whitelisted plugins).
# See https://pages.github.com/versions/ . Update with `bundle update github-pages`.
gem "github-pages", group: :jekyll_plugins

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: [:windows, :jruby]

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1", platforms: [:windows]

# Required by Jekyll 3.x on Ruby >= 3.0 for `jekyll serve`
gem "webrick", "~> 1.8"
